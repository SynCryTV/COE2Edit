	order_index: 1
	quest_links: [ ]
	quests: [
		{
			description: [
				"&eRefined Storage&r ist die beste Methode für Item-Lagerung, Filterung und Massen-Crafting. Geräte im Lagernetzwerk verwalten deine Gegenstände, die auf Disks gespeichert sind. "
				""
				"Der &eController&r ist das Herzstück des Lagernetzwerks. Alle anderen Refined-Storage-Geräte müssen sich mit ihm verbinden, entweder in seiner Nähe oder über Kabel."
				""
				"Ein einfaches Lagersystem (&eController, Disk Drive, External Storage und ein beliebiges Grid&r) verbraucht 0 Energie im Betrieb!"
				""
				"Diese Questreihe ist nicht vollständig. Schau in &eJEI&r für die vollständige Liste der Gegenstände und Möglichkeiten von Refined Storage nach."
			]
			id: "6390924916E0EF54"
			rewards: [{
				auto: "enabled"
				command: "/mine_and_slash give xp_times_lvl @p 100"
				elevate_perms: true
				icon: "ftb_ph:exp"
				id: "5703DB65FB3ABDD3"
				silent: true
				title: "100 Erfahrung x Level"
				type: "command"
			}]
			subtitle: "Refined Storage"
			tasks: [{
				id: "4B2ED6A485F2593C"
				item: "refinedstorage:controller"
				type: "item"
			}]
			title: "Verknüpfte Truhen"
			x: 0.0d
			y: 0.0d
		}
		{
			description: [
				"Mit &eSophisticated Backpacks&r kannst du mit einem Rucksack alles machen, was du dir wünschst. Es gibt zahlreiche Upgrades, von automatischem Füttern über Craften und Schmelzen im Rucksack bis hin zum Transport von Flüssigkeiten und Erfahrung in flüssiger Form. Schau in JEI für die vollständige Liste der Upgrades nach."
				""
				"Jede Rucksack-Stufe bietet mehr Upgrade-Plätze und mehr Inventarplatz."
				""
				"&eRucksack: &r27 Plätze, 1 Upgrade-Platz"
				""
				"&eEisenrucksack:&r 54 Plätze, 2 Upgrade-Plätze"
				""
				"&eGoldrucksack:&r 81 Plätze, 3 Upgrade-Plätze"
				""
				"&eDiamantrucksack:&r 108 Plätze, 5 Upgrade-Plätze"
				""
				"&eNetheritrucksack:&r 120 Plätze, 7 Upgrade-Plätze"
			]
			id: "309037CD749F2133"
			rewards: [{
				auto: "enabled"
				command: "/mine_and_slash give xp_times_lvl @p 100"
				elevate_perms: true
