		}
		{
			dependencies: ["201E621A52FFCE65"]
			description: ["Während du Monster tötest und die Karte erkundest, bemerkst du, wie dein Tötungs- und Beute-Prozentsatz steigt. Diese beiden Werte tragen zu deiner gesamten &eErkundungs-Seltenheit&r bei. Je höher deine Erkundung, desto besser die Belohnungen beim Töten des &eKarten-Bosses&r. Je mehr du erkundest, desto mehr steigt deine Erkundungs-Seltenheit, beginnend mit &aungewöhnlicher&r Erkundung als erstem Meilenstein."]
			icon: "minecraft:paper"
			id: "4983FE0DE8A1377F"
			rewards: [{
				id: "72DE3FED05338CB6"
				item: "mmorpg:currency/map_rarity_upgrade"
				type: "item"
			}]
			subtitle: "Verlorene Seite"
			tasks: [{
				id: "743D361CB7F4E030"
				title: "Einmal klicken, wenn gelesen"
