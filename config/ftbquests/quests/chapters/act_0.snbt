	quests: [
		{
			description: [
				"&nWillkommen bei die Federn des Vergessens&r - einem stark angepassten Modpack, das Minecraft in ein Action-RPG verwandelt."
				""
				"Das erste Kapitel der Quests, \"Prolog\", soll dir einen Überblick über bestimmte Systeme im Modpack geben, die sich von dem unterscheiden, was du aus den meisten Minecraft-Modpacks gewohnt bist."
				""
				"&eSchließe jede \"Seite\" des Prologs ab, indem du auf das Häkchen klickst.&r"
				""
				"Weitere Informationen findest du in unserem &9Wiki&r (den Link findest du auch im Hauptmenü)."
				""
				"Tritt gerne auch unserem &9Discord&r-Server bei (Link ebenfalls im Hauptmenü), wo wir dir bei Problemen im Spiel helfen können oder du einfach mit uns über das Modpack plaudern kannst!"
			]
			icon: "minecraft:writable_book"
			id: "30403B3DE1E47F33"
			rewards: [
				{
					id: "662E6BDEDAE044A6"
					item: "sophisticatedbackpacks:iron_backpack"
					type: "item"
				}
				{
					count: 12
					id: "4E506FC73E0B1EAC"
					item: "minecraft:bread"
					title: "Brot"
					type: "item"
				}
			]
			subtitle: "Inhaltsverzeichnis"
			tasks: [{
				id: "77FDE21B75D712EC"
				title: "Einmal klicken, wenn gelesen"
				type: "checkmark"
			}]
			title: "Willkommen bei Die Federn des Vergessens!"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["624D8CD0A4A6668B"]
			description: [
				"DFDV unterstützt Gruppen-Questen und gemeinsames Spiel. &eAlle Team-/Gruppenoptionen sind über das Inventar erreichbar!&r"
				""
				"Es gibt 3 verschiedene Befehle für das Gruppenspiel:"
				""
				"Die &eMine and Slash&r-Teams ermöglichen es, EXP zu teilen und sich gegenseitig zu heilen/buffen. Zusätzlich siehst du die Werte für Leben/Magieschild deiner Gruppenmitglieder in der Oberfläche!"
				""
				"FTB Teams ermöglicht das Teilen des Quest-Fortschritts. FTB Teams hat außerdem ein eigenes Team-Chat-Menü, standardmäßig über - erreichbar."
				""
				"Lightman's Teams ermöglicht das Teilen von Geld und Händler-Benachrichtigungen."
			]
			icon: "ftbquests:book"
			id: "48075B2F138A9C2C"
			rewards: [{
				id: "7F6AE3A345D1324D"
				item: "lightmanscurrency:coin_iron"
